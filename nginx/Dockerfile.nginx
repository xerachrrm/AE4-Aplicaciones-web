# Imagen del servidor Web nginx (curso DPL, UT4)
# Basada en Ubuntu 24.04 + apt (coherente con el resto del curso; sin systemd
# en contenedores: nginx se lanza en foreground). Uso: docker compose up -d
FROM ubuntu:24.04

# Instala nginx y elimina la configuración por defecto
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

# Configuración del sitio: sirve el build de Vite y proxya la API
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Build de Vite (Web Components) como contenido estático
COPY frontend/dist /usr/share/nginx/html

EXPOSE 80

# Sin systemd en contenedores: nginx en primer plano
CMD ["nginx", "-g", "daemon off;"]